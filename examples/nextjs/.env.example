# Copiez ce fichier en .env.local. Variables SERVEUR uniquement : jamais de préfixe NEXT_PUBLIC_.

# sandbox (https://sandbox-app.feexpay.me, clé test_key_…) ou live (https://app-v2.feexpay.me, clé fp_…)
FEEXPAY_ENV=sandbox
FEEXPAY_API_KEY=test_key_votre_cle_privee
FEEXPAY_SHOP_ID=identifiant_public_de_la_boutique

# Valeur saisie dans le tableau de bord FeexPay, section Webhooks (auth_type Bearer).
# Générez-la avec : openssl rand -hex 32
FEEXPAY_WEBHOOK_SECRET=
